# Copy this file to configs/local/secrets.env and fill values locally.
# configs/local/ is ignored by Git.

OPENAI_API_KEY=
KEENABLE_API_KEY=

# Local OpenAI-compatible VLM server. Use a non-secret placeholder if the server
# does not require authentication.
LOCAL_VLM_API_KEY=local
LOCAL_VLM_BASE_URL=http://127.0.0.1:8000/v1
GLM_VLM_BASE_URL=http://GLM_HOST:8080/v1
QWEN_VLM_BASE_URL=http://QWEN_HOST:8080/v1
QWEN_VLM_512K_BASE_URL=http://QWEN_512K_HOST:8080/v1
